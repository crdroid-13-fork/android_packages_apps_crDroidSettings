<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings">

    <PreferenceCategory
         android:title="@string/gaming_category">

    <!-- Gaming mode -->
    <Preference
        android:key="gaming_mode"
        android:icon="@drawable/ic_gaming"
        android:title="@string/gaming_mode_title"
        android:summary="@string/gaming_mode_summary">

        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="io.chaldeaprjkt.gamespace"
            android:targetClass="io.chaldeaprjkt.gamespace.settings.SettingsActivity" />
    </Preference>
    </PreferenceCategory>

    <PreferenceCategory
         android:title="@string/spoofing_category">

    <!-- Play Integrity Fix -->
    <Preference
        android:key="play_integrity_fix"
        android:icon="@drawable/ic_fingerprint"
        android:title="@string/play_integrity_fix_title"
        android:summary="@string/play_integrity_fix_summary"
        android:fragment="com.crdroid.settings.fragments.misc.PlayIntegrityFix" />

    <!-- TrickyStore -->
    <Preference
        android:key="tricky_store"
        android:icon="@drawable/ic_vpn_key"
        android:title="@string/tricky_store_title"
        android:summary="@string/tricky_store_summary"
        android:fragment="com.crdroid.settings.fragments.misc.TrickyStore" />

    <!-- Hide applist -->
    <Preference
        android:key="hide_applist_setting"
        android:icon="@drawable/ic_hide_applist"
        android:title="@string/hide_applist_title"
        android:summary="@string/hide_applist_summary"
        android:fragment="com.crdroid.settings.fragments.misc.HideAppListSettings" />

    <!-- Vbmeta hash attestation -->
    <com.crdroid.settings.preferences.SystemPropertySwitchPreference
        android:key="persist.sys.vbmeta.update"
        android:icon="@drawable/ic_vbmeta"
        android:title="@string/vbmeta_attestation_title"
        android:summary="@string/vbmeta_attestation_summary"
        android:defaultValue="false" />

    <!-- hide developer option -->
    <Preference
        android:key="hide_developer_status_settings"
        android:icon="@drawable/ic_developer_options"
        android:title="@string/hide_developer_status_title"
        android:summary="@string/hide_developer_status_summary"
        android:fragment="com.crdroid.settings.fragments.misc.HideDeveloperStatusSettings"
        settings:controller="com.crdroid.settings.fragments.misc.HideDeveloperStatusPreferenceController" />
    </PreferenceCategory>

    <PreferenceCategory
         android:title="@string/other_category">

    <!-- Google services -->
    <Preference
        android:key="gms_enabled_settings"
        android:icon="@drawable/ic_google"
        android:title="@string/gms_enabled_title"
        android:summary="@string/gms_enabled_summary"
        android:fragment="com.crdroid.settings.fragments.misc.GmsSwitch"/>

    <!-- Disable flash sms -->
     <com.crdroid.settings.preferences.SystemSettingSwitchPreference
         android:key="disable_flash_sms"
         android:icon="@drawable/ic_flash_sms"
         android:title="@string/disable_flash_sms_title"
         android:summary="@string/disable_flash_sms_summary"
         android:defaultValue="false"/>

    <!-- Block PairIP license activity -->
     <com.crdroid.settings.preferences.SystemPropertySwitchPreference
         android:key="persist.sys.pairip.activity.block"
         android:icon="@drawable/ic_chain"
         android:title="@string/miscellaneous_pairip_activity_block_title"
         android:summary="@string/miscellaneous_pairip_activity_block_summary"
         android:defaultValue="false" />

   <!-- Shake Gesture -->
     <Preference
         android:key="gesture_shake_action"
         android:icon="@drawable/ic_shake_gesture"
         android:title="@string/shake_gestures_enabled_title"
         android:summary="@string/shake_gestures_enabled_summary"
         android:fragment="com.crdroid.settings.fragments.misc.ShakeGestures" />

    <!-- Parallel space -->
    <Preference
        android:key="parallel_space"
        android:icon="@drawable/ic_parallel_space"
        android:title="@string/laboratory_parallel_space_title"
        android:summary="@string/laboratory_parallel_space_summary">
        <intent
            android:targetPackage="ink.kscope.parallelspace"
            android:targetClass="ink.kscope.parallelspace.MainActivity" />
    </Preference>

    <!-- Three-fingers-swipe to screenshot -->
    <com.crdroid.settings.preferences.SystemSettingSwitchPreference
        android:key="three_finger_gesture"
        android:icon="@drawable/ic_three_finger_gesture"
        android:title="@string/three_finger_gesture"
        android:summary="@string/three_finger_gesture_summary"
        android:defaultValue="false" />

    <!-- Sensor block per package -->
    <Preference
        android:key="sensor_block_settings"
        android:icon="@drawable/ic_remote"
        android:title="@string/sensor_block_title"
        android:summary="@string/sensor_block_summary"
        android:fragment="com.crdroid.settings.fragments.misc.SensorBlock"/>

    <!-- Pocket Judge -->
    <com.crdroid.settings.preferences.SystemSettingSwitchPreference
        android:key="pocket_judge"
        android:icon="@drawable/ic_pocket"
        android:title="@string/pocket_judge_title"
        android:summary="@string/pocket_judge_summary"
        android:defaultValue="false" />

    <!-- Weather -->
    <Preference
        android:icon="@drawable/ic_omnijaws"
        android:title="@string/weather_settings_title"
        android:summary="@string/weather_settings_summary">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="org.omnirom.omnijaws"
            android:targetClass="org.omnirom.omnijaws.SettingsActivity" />
    </Preference>
    </PreferenceCategory>
</PreferenceScreen>
